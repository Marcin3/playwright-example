    "@playwright/test": "1.58.2",
    "@types/node": "25.4.0",
    "eslint": "9.39.2",
    "eslint-plugin-playwright": "2.5.1",
    "prettier": "3.8.1",
    "prettier-plugin-organize-imports": "4.3.0",
    "typescript-eslint": "8.55.0"
  },
