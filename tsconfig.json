{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "dom"],
    "target": "es2024",
    "noEmit": true,
    /* Linting and formatter */
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@fixtures/*": ["./fixtures/*"],
      "@pages/*": ["./pages/*"]
    },
    "resolveJsonModule": true,
    "strict": true
  },
  "exclude": ["node_modules"]
}
